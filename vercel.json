{
  "buildCommand": "pnpm --filter @workspace/quotation-compare run build && pnpm --filter @workspace/api-server run build:vercel",
  "outputDirectory": "artifacts/quotation-compare/dist/public",
  "functions": {
    "api/index.mjs": {
      "maxDuration": 60
    }
  },
  "rewrites": [
    { "source": "/api/:path*", "destination": "/api" },
    { "source": "/((?!api/).*)", "destination": "/index.html" }
  ]
}
